# Default Chinese/OpenAI-compatible provider: DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Alternative examples:
# Qwen DashScope OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# Zhipu OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4-plus

# Moonshot/Kimi OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k

# Local OpenAI-compatible endpoint, such as Ollama/vLLM/LM Studio
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# Demo-specific keys
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOKEN=
