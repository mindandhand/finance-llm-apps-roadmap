{
  "name": "open-mcp-client",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test:workspace": "tsx --test apps/web/lib/workspace/workspace.test.ts",
    "test:workspace:coverage": "tsx --test --experimental-test-coverage apps/web/lib/workspace/workspace.test.ts",
    "test:workspace:integration": "tsx --test apps/web/lib/workspace/workspace.integration.test.ts",
    "lint": "turbo run lint",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.turbo .turbo",
    "fresh": "pnpm clean && pnpm i"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "turbo": "^2.3.3",
    "tsx": "^4.21.0"
  },
  "packageManager": "pnpm@10.13.1"
}
